# Environment Configuration for Spatial SAE Research Repository

# Hugging Face Hub token (optional, for accessing gated VLM checkpoints)
HF_TOKEN=your_huggingface_token_here

# Paths
DATA_DIR=./data
CHECKPOINT_DIR=./checkpoints
OUTPUT_DIR=./outputs

# Compute
CUDA_VISIBLE_DEVICES=0
TORCH_NUM_THREADS=4

# Logging & Experiment Tracking
LOG_LEVEL=INFO
WANDB_ENABLED=false
WANDB_PROJECT=spatial-sae
